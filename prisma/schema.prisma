generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  password     String
  role         String   @default("AGENT") // ADMIN ou AGENT
  isActive     Boolean  @default(true)
  // Réseaux autorisés pour cet utilisateur (JSON array de codes réseau)
  // ex: ["mtn-ci","orange-ci","wave-ci"]
  // null = tous les réseaux (admin uniquement)
  allowedNetworks String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
